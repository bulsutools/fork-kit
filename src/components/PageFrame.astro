---
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
	<header class="header"><slot name="header" /></header>
	{
		hasSidebar && (
			<nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
				<MobileMenuToggle />
				<div id="starlight__sidebar" class="sidebar-pane">
					<div class="sidebar-content sl-flex">
						<slot name="sidebar" />
					</div>
				</div>
			</nav>
		)
	}
	<div class="main-frame"><slot /></div>
	<footer class="site-footer">
		<div class="site-footer__inner">
			<div class="site-footer__col">
				<a class="site-footer__brand" href="https://bulsu.tools">BulSU Tools</a>
				<ul class="site-footer__list">
					<li><a href="https://bulsu.tools">Org site</a></li>
					<li><a href="https://room-tba.bulsu.tools">Room TBA</a></li>
					<li><a href="https://geary.bulsu.tools">Geary</a></li>
					<li><a href="https://gwa-calculator.bulsu.tools">GWA Calculator</a></li>
					<li><a href="https://github.com/bulsutools/alab-grade-tools">ALAB Grade Tools</a></li>
					<li><a href="https://github.com/bulsutools/alab-gradesim">alab-gradesim</a></li>
					<li><a href="https://fork.bulsu.tools">Fork Kit</a></li>
				</ul>
			</div>
			<div class="site-footer__col">
				<span class="site-footer__label">Upstream</span>
				<ul class="site-footer__list">
					<li><a href="https://uplb.tools">uplb.tools</a></li>
					<li><a href="https://room-tba.uplb.tools">Room TBA (UPLB)</a></li>
					<li><a href="https://github.com/uplbtools">uplbtools</a></li>
				</ul>
			</div>
		</div>
		<p class="site-footer__credit">Campus fork toolkit — guides for standing up your own campus org.</p>
	</footer>
</div>

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			padding-inline-end: var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-nav);
		}

		:global([data-has-sidebar]) .header {
			padding-inline-end: calc(
				var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
			);
		}

		.sidebar-pane {
			visibility: var(--sl-sidebar-visibility, hidden);
			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 0;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-black);
			overflow-y: auto;
			scrollbar-gutter: stable;
		}

		:global([aria-expanded='true']) ~ .sidebar-pane {
			--sl-sidebar-visibility: visible;
		}

		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 1rem var(--sl-sidebar-pad-x) 0;
			flex-direction: column;
			gap: 1rem;
		}

		@media (min-width: 50rem) {
			.sidebar-content::after {
				content: '';
				padding-bottom: 1px;
			}
		}

		.main-frame {
			flex: 1 0 auto;
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
		}

		.site-footer {
			border-top: 1px solid var(--sl-color-hairline-shade);
			background-color: var(--sl-color-bg-sidebar);
			padding: 2rem var(--sl-nav-pad-x);
		}

		.site-footer__inner {
			display: flex;
			flex-wrap: wrap;
			gap: 2rem 4rem;
			max-width: 72rem;
			margin-inline: auto;
		}

		.site-footer__col {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			min-width: 10rem;
		}

		.site-footer__brand {
			font-weight: 600;
			font-size: var(--sl-text-h4);
			color: var(--sl-color-white);
			text-decoration: none;
		}

		.site-footer__brand:hover {
			text-decoration: underline;
		}

		.site-footer__label {
			font-weight: 600;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		.site-footer__list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 0.375rem;
		}

		.site-footer__list a {
			color: var(--sl-color-gray-2);
			text-decoration: none;
			font-size: var(--sl-text-sm);
		}

		.site-footer__list a:hover {
			color: var(--sl-color-white);
			text-decoration: underline;
		}

		.site-footer__credit {
			max-width: 72rem;
			margin: 1.5rem auto 0;
			font-size: var(--sl-text-xs);
			color: var(--sl-color-gray-3);
		}

		@media (min-width: 50rem) {
			:global([data-has-sidebar]) .header {
				padding-inline-end: var(--sl-nav-pad-x);
			}
			.sidebar-pane {
				--sl-sidebar-visibility: visible;
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline-shade);
			}
		}
	}
</style>
